NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mitsales
FRONTEND_URL=http://localhost:3000

BETTER_AUTH_SECRET=replace-with-a-long-secret
BETTER_AUTH_URL=http://localhost:5000
GOOGLE_CLIENT_ID=replace-google-client-id
GOOGLE_CLIENT_SECRET=replace-google-client-secret

ACCESS_TOKEN_SECRET=replace-access-secret
REFRESH_TOKEN_SECRET=replace-refresh-secret
ACCESS_TOKEN_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=30d
BETTER_AUTH_SESSION_TOKEN_EXPIRES_IN=2592000
BETTER_AUTH_SESSION_TOKEN_UPDATE_AGE=86400

STRIPE_SECRET_KEY=sk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
STRIPE_PUBLISHABLE_KEY=pk_test_replace

CLOUDINARY_CLOUD_NAME=replace
CLOUDINARY_API_KEY=replace
CLOUDINARY_API_SECRET=replace

EMAIL_SENDER_SMTP_USER=replace
EMAIL_SENDER_SMTP_PASS=replace
EMAIL_SENDER_SMTP_HOST=smtp.gmail.com
EMAIL_SENDER_SMTP_PORT=587
EMAIL_SENDER_SMTP_FROM="M ITSales <support@mitsales.com>"

PLATFORM_SUPER_ADMIN_NAME=Platform Super Admin
PLATFORM_SUPER_ADMIN_EMAIL=platformadmin@gmail.com
PLATFORM_SUPER_ADMIN_PASSWORD=12345678

SUBSCRIPTION_BYPASS=true
